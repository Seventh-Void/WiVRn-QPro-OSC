<!-- fpsVR-style stats panel for an existing WayVR watch.
     Put this file next to your watch.xml (~/.config/wayvr/theme/gui/) and add
         <include src="fpsvr-stats.xml" />
     inside <elements> of your watch.xml, where the panel should go (e.g. right below the clock box).
     Add fpsvr-button.xml too for the Hide/Show stats button. Needs wayvr-stats running (see README.md). -->
<layout>
  <theme>
    <!-- Colors of this add-on only (white). Change them to match your watch. -->
    <var key="fv_color_bg" value="#101010" />
    <var key="fv_color_text" value="#FFFFFF" />
    <var key="fv_color_accent" value="#FFFFFF" />
    <var key="fv_color_accent_translucent" value="#FFFFFF99" />
    <var key="fv_color_accent_40" value="#FFFFFF66" />
    <var key="fv_color_accent_10" value="#FFFFFF1A" />
    <var key="fv_color_faded" value="#C8C8C8" />
  </theme>

  <macro name="fv_rect"
         padding="8" color="~fv_color_bg"
         border="2" border_color="~fv_color_accent" round="8" />

  <macro name="fv_button"
         padding="8"
         border_color="~fv_color_accent_translucent"
         border="2"
         round="8"
         color="~fv_color_accent_40"
         color2="~fv_color_accent_10"
         gradient="vertical"
         align_items="center"
         justify_content="center" />

  <!-- fpsVR-style column: header with frame time, graph, temp/load, memory -->
  <template name="FvStatColumn">
    <div id="fv_${key}_col" flex_direction="column" gap="2">
      <div justify_content="space_between" width="100%">
        <label text="${name}" size="14" color="~fv_color_faded" weight="bold" />
        <label id="fv_${key}_ms" text="-- ms" size="14" color="~fv_color_text" weight="bold" />
      </div>
      <rectangle id="fv_${key}_graphbox" border="1" border_color="~fv_color_accent_40" round="4">
        <image id="fv_${key}_graph" width="150" height="36" src="fpsvr/graph-empty.svg" />
      </rectangle>
      <label id="fv_${key}" text="--" size="13" color="~fv_color_text" />
      <label id="${extra}" text="--" size="13" color="~fv_color_faded" />
    </div>
  </template>

  <elements>
    <!-- fpsVR-style stats, filled in by wayvr-stats (see README.md next to this file).
         Hidden with the stats button in the clock box (next to the edit button). -->
    <rectangle id="fv_panel" macro="fv_rect" flex_direction="column" gap="4">
      <label id="fv_title" text="No VR app" size="14" color="~fv_color_accent" weight="bold" />
      <!-- FPS left, Avg FPS right; Minimal mode shows only this row -->
      <div id="fv_fpsrow" justify_content="space_between" width="100%">
        <label id="fv_fps" text="FPS --" size="14" color="~fv_color_text" weight="bold" />
        <label id="fv_avg_fps" text="Avg --" size="14" color="~fv_color_text" weight="bold" />
      </div>
      <div id="fv_cols" justify_content="space_between" width="100%">
        <FvStatColumn name="GPU" key="gpu" extra="fv_vram" />
        <FvStatColumn name="CPU" key="cpu" extra="fv_ram" />
      </div>
    </rectangle>
  </elements>
</layout>
