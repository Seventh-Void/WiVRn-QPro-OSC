#!/usr/bin/env python3
"""fpsVR-style stats panel on the WayVR watch.

Per-frame CPU/GPU times and the name of the focused VR app come from
/dev/shm/wivrn-frametime, written by wivrn-server from WiVRn-QPro-OSC
(v26.9-qpro.3 or later). Temps, load, VRAM and RAM come from sysfs/procfs.
Everything goes to the watch through one persistent `wayvrctl batch` pipe.
Values that can't be read on this machine stay "--"; nothing is estimated.

Started by wayvr-stats.path whenever WayVR (re)writes its pid file; exits once
that WayVR is gone.
"""
import collections
import contextlib
import datetime
import glob
import mmap
import re
import sqlite3
import os
import struct
import subprocess
import time

SHM = "/dev/shm/wivrn-frametime"
RUNDIR = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
GRAPH = os.path.join(RUNDIR, "wayvr-stats-{}-{}.svg")  # alternates 0/1 so WayVR never reads a half-written file
PIDFILE = os.path.join(RUNDIR, "wayvr.pid")
# WayVR truncates its log on every start, so save it as soon as WayVR exits
WAYVR_LOG = os.environ.get("WAYVR_LOGFILE", "/tmp/wayvr.log")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "wayvr-stats")
CRASH = re.compile(r"panicked|Atlas full")
KEEP_CRASHES = 10
VRCX_DB = os.path.expanduser("~/.config/VRCX/VRCX.sqlite3")  # optional: VRChat world time
HIDDEN = os.path.join(RUNDIR, "wayvr-stats.hidden")  # made/removed by the watch's Hide/Show buttons
W, H = 150, 36                      # must match the fv_*_graph sprites in watch.xml; 1 px per frame
GRAPH_HZ, LABEL_HZ = 15, 3
COLOR = os.environ.get("WAYVR_STATS_COLOR", "#FFFFFF")  # graph color, #RRGGBB
GRAPHS = os.environ.get("WAYVR_STATS_GRAPHS") == "1"  # needs a patched WayVR, see README.md
# Layout from app_pacer.cpp: u64 count, u32 period_us, u32 reserved, char app_name[64], frames
HDR, NAME, FRAME, RING = struct.Struct("=QII"), 64, struct.Struct("=II"), 256
FRAMES_AT = HDR.size + NAME
GIB = 1 << 30


def hwmon(name):
    for h in glob.glob("/sys/class/hwmon/hwmon*"):
        if open(f"{h}/name").read().strip() == name:
            return h
    return None


# hwmon numbers change between boots, so look sensors up by driver name.
# amdgpu temp2 = junction (hotspot); k10temp temp1 = Tctl; coretemp temp1 = package.
GPU_MON, CPU_MON = hwmon("amdgpu"), hwmon("k10temp") or hwmon("coretemp")


def num(path, default=0):
    try:
        return int(open(path).read())
    except (OSError, ValueError, TypeError):
        return default


def wayvr_pid():
    try:
        pid = open(PIDFILE).read().strip()
    except OSError:
        return None
    return pid if pid and os.path.exists(f"/proc/{pid}") else None


def cpu_times():
    v = list(map(int, open("/proc/stat").readline().split()[1:9]))
    return sum(v), v[3] + v[4]  # total, idle + iowait


def ram_gib():
    m = dict(line.split()[:2] for line in open("/proc/meminfo"))
    return (int(m["MemTotal:"]) - int(m["MemAvailable:"])) * 1024 / GIB, int(m["MemTotal:"]) * 1024 / GIB


def quote(s):
    return "'" + s.replace("'", "'\\''") + "'"


# fpsVR-style bar colors per frame: within budget, up to 25 % over, worse
GOOD, LATE, BAD = "#22C55E", "#F59E0B", "#EF4444"
TEXT = os.environ.get("WAYVR_STATS_TEXT", "#FFFFFF")  # labels that are fine; match the watch's text color


def ms_color(us, period_us):
    return GOOD if us <= period_us else LATE if us <= period_us * 5 // 4 else BAD


def fps_color(fps, period_us):
    target = round(1e6 / period_us)  # 11111 us -> 90 fps
    return GOOD if fps >= target * 0.9 else LATE if fps >= target / 2 else BAD


def label_color(c):
    return TEXT if c == GOOD else c  # labels only stand out when orange or red


def svg(values, period_us):
    """One 1 px bar per frame, colored by its frame time against the frame budget."""
    top = 3 * period_us // 2  # dashed line = frame budget, at 2/3 height
    x0 = W - len(values)
    bars = {GOOD: [], LATE: [], BAD: []}
    for i, v in enumerate(values):
        bars[ms_color(v, period_us)].append(f"M{x0 + i}.5 {H}V{H - min(v, top) * H // top}")
    paths = "".join(f'<path d="{"".join(d)}" stroke="{c}"/>' for c, d in bars.items() if d)
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}">{paths}'
            f'<path d="M0 {H - period_us * H // top} H{W}" stroke="{COLOR}88" stroke-dasharray="3 3"/></svg>')


def vrcx_running():
    for comm in glob.glob("/proc/[0-9]*/comm"):
        try:
            if open(comm).read().strip() == "VRCX":
                return True
        except OSError:  # process exited while scanning
            pass
    return False


def vrcx_world():
    """(world name, unix join time) of VRCX's newest location entry, or None without VRCX."""
    if not os.path.exists(VRCX_DB):  # no VRCX: world time stays off (turns on once VRCX is installed)
        return None
    if not vrcx_running():  # VRCX closed: it isn't logging world changes, so its newest world may be stale
        return None
    try:
        with contextlib.closing(sqlite3.connect(f"file:{VRCX_DB}?mode=ro", uri=True, timeout=0.2)) as db:
            row = db.execute("SELECT world_name, created_at FROM gamelog_location ORDER BY id DESC LIMIT 1").fetchone()
        return row[0], datetime.datetime.fromisoformat(row[1]).timestamp()
    except (sqlite3.Error, TypeError, ValueError):
        return None


def save_wayvr_log():
    """Copy the exited WayVR's log to STATE/last-wayvr.log, and to crash-<time>.log if it crashed."""
    try:
        text = open(WAYVR_LOG, errors="replace").read()[-4 << 20:]  # last 4 MB is plenty
    except OSError:
        return
    os.makedirs(STATE, exist_ok=True)
    open(os.path.join(STATE, "last-wayvr.log"), "w").write(text)
    if not CRASH.search(text):
        return
    def version(cmd):
        try:
            return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip().replace("\n", ", ") or "?"
        except (OSError, subprocess.SubprocessError):
            return "?"
    path = os.path.join(STATE, time.strftime("crash-%Y%m%d-%H%M%S.log"))
    header = (f"# WayVR crash log saved by wayvr-stats, {time.strftime('%Y-%m-%d %H:%M:%S %z')}\n"
              f"# {version(['pacman', '-Q', 'wayvr', 'wivrn-server'])}\n# kernel {os.uname().release}\n\n")
    open(path, "w").write(header + text)
    for old in sorted(glob.glob(os.path.join(STATE, "crash-*.log")))[:-KEEP_CRASHES]:
        os.remove(old)
    print(f"WayVR crashed; its log is saved in {path}", flush=True)


def duration(s):
    m = int(s // 60)
    return f"{m} min" if m < 60 else f"{m // 60} h {m % 60} min"


def run(pid):
    ctl = subprocess.Popen(["wayvrctl", "batch", "--fail-fast"], stdin=subprocess.PIPE,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, text=True)
    shown = {}  # element id -> text currently on the watch
    colors = {}  # element id -> color currently on the watch

    def label(wid, text):
        if shown.get(wid) != text:
            shown[wid] = text
            ctl.stdin.write(f"panel-modify watch {wid} set-text -- {quote(text)}\n")

    def color(wid, hex_color):
        if colors.get(wid) != hex_color:
            colors[wid] = hex_color
            ctl.stdin.write(f"panel-modify watch {wid} set-color '{hex_color}'\n")

    shm, last, flip = None, 0, 0
    cpu_hist, gpu_hist = collections.deque(maxlen=W), collections.deque(maxlen=W)
    recent = collections.deque()  # (arrival time, cpu_us, gpu_us) over the last second
    app, app_start, app_frames = "", 0.0, 0
    period_us, next_label, hidden, fps_from = 11111, 0.0, False, 0.0  # fps_from: start of a gap-free 1 s window
    seen, alive_at = -1, -1e9  # frame counter last seen, and when it last moved
    world, world_at = None, 0.0  # cached vrcx_world() and when it was read
    pt, pi = cpu_times()

    def header(now):
        """Read the shm header only: focused app and frame counter. Returns the counter."""
        nonlocal app, app_start, app_frames, fps_from, last, period_us, seen, alive_at
        count, period_us, _ = HDR.unpack_from(shm)
        period_us = period_us or 11111
        name = shm[HDR.size:FRAMES_AT].split(b"\0", 1)[0].decode(errors="replace")
        name = name if len(name) <= 30 else name[:29] + "…"  # fit the watch width
        if name != app:  # new focused app: restart session stats
            app, app_start, app_frames, fps_from = name, now, 0, now
            cpu_hist.clear(), gpu_hist.clear()
        if count < last:  # wivrn-server restarted
            last = count
        if count != seen:
            seen, alive_at = count, now
        return count

    def session(now):
        nonlocal world, world_at
        # under the clock, so it stays visible (and counting) while the stats panel is hidden
        in_game = app and now - alive_at < 5
        name = app if len(app) <= 16 else app[:15] + "…"  # the clock face is narrower than the panel
        label("fv_session", f"{name} - {duration(now - app_start)}" if in_game else "No VR game")
        if in_game and "VRChat" in app:
            if now - world_at >= 5:
                world, world_at = vrcx_world(), now
        else:
            world = None
        if world:
            wname = world[0] if len(world[0]) <= 16 else world[0][:15] + "…"
            label("fv_world", f"{wname} - {duration(time.time() - world[1])}")
        else:
            label("fv_world", "")

    try:
        while os.path.exists(f"/proc/{pid}") and ctl.poll() is None:
            now = time.monotonic()

            if shm is None and os.path.exists(SHM) and os.path.getsize(SHM) >= FRAMES_AT + RING * FRAME.size:
                with open(SHM, "rb") as f:
                    shm = mmap.mmap(f.fileno(), 0, prot=mmap.PROT_READ)
                last = HDR.unpack_from(shm)[0]  # start from now, skip old frames

            if os.path.exists(HIDDEN):  # panel hidden: only the game time under the clock keeps going
                hidden = True
                if shm is not None:
                    prev = app
                    count = header(now)
                    if app != prev:  # don't count the old app's frames in the new one's Avg
                        last = count
                session(now)
                label("fv_title", app or "No VR app")  # in the header, which stays visible
                ctl.stdin.flush()
                time.sleep(0.5)
                continue
            if hidden:  # shown again: drop the stale graphs, but keep the missed frames in Avg
                hidden = False
                if shm is not None:
                    count = header(now)
                    app_frames += max(count - last, 0)
                    last = count
                cpu_hist.clear(), gpu_hist.clear(), recent.clear()
                pt, pi, fps_from = *cpu_times(), now

            new = 0
            if shm is not None:
                count = header(now)
                for n in range(max(last, count - RING), count):
                    c, g = FRAME.unpack_from(shm, FRAMES_AT + (n % RING) * FRAME.size)
                    cpu_hist.append(c), gpu_hist.append(g), recent.append((now, c, g))
                    new += 1
                app_frames += new
                last = count
            while recent and recent[0][0] < now - 1:
                recent.popleft()

            # Graphs are opt-in: unpatched WayVR (26.8.0) never frees its glyph atlas,
            # so every new graph image leaks until WayVR dies with "Atlas full".
            # See wayvr-pkg/glyph-atlas-trim.patch / README.md.
            if new and GRAPHS:
                for key, hist in (("gpu", gpu_hist), ("cpu", cpu_hist)):
                    path = GRAPH.format(key, flip)
                    with open(path, "w") as f:
                        f.write(svg(hist, period_us))
                    ctl.stdin.write(f"panel-modify watch fv_{key}_graph set-image {path}\n")
                flip ^= 1

            if now >= next_label:
                next_label = now + 1 / LABEL_HZ
                session(now)
                if app and recent:
                    n = len(recent)
                    avg = app_frames / max(now - app_start, 1e-3)
                    gpu_us, cpu_us = sum(r[2] for r in recent) / n, sum(r[1] for r in recent) / n
                    label("fv_title", app)
                    if now - fps_from >= 1:  # needs a full 1 s window
                        label("fv_fps", f"FPS {n}"), color("fv_fps", label_color(fps_color(n, period_us)))
                    else:
                        label("fv_fps", "FPS --"), color("fv_fps", TEXT)
                    label("fv_avg_fps", f"Avg {avg:.1f}"), color("fv_avg_fps", label_color(fps_color(avg, period_us)))
                    label("fv_gpu_ms", f"{gpu_us / 1000:.1f} ms"), color("fv_gpu_ms", label_color(ms_color(gpu_us, period_us)))
                    label("fv_cpu_ms", f"{cpu_us / 1000:.1f} ms"), color("fv_cpu_ms", label_color(ms_color(cpu_us, period_us)))
                else:
                    label("fv_title", app or "No VR app")
                    label("fv_fps", "FPS --")
                    label("fv_gpu_ms", "-- ms")
                    label("fv_cpu_ms", "-- ms")
                    for wid in ("fv_fps", "fv_avg_fps", "fv_gpu_ms", "fv_cpu_ms"):
                        color(wid, TEXT)

                t, i = cpu_times()
                cpu_load, pt, pi = 100 * ((t - pt) - (i - pi)) // max(t - pt, 1), t, i
                temp = f"{num(f'{CPU_MON}/temp1_input') // 1000}°C  " if CPU_MON else ""
                label("fv_cpu", f"{temp}{cpu_load}%")
                if GPU_MON:
                    dev = f"{GPU_MON}/device"
                    label("fv_gpu", f"{num(f'{GPU_MON}/temp2_input') // 1000}°C  {num(f'{dev}/gpu_busy_percent')}%")
                    label("fv_vram", f"VRAM {num(f'{dev}/mem_info_vram_used') / GIB:.1f}/{num(f'{dev}/mem_info_vram_total') / GIB:.1f} GB")
                used, total = ram_gib()
                label("fv_ram", f"RAM {used:.1f}/{total:.1f} GB")

            ctl.stdin.flush()
            time.sleep(1 / GRAPH_HZ)
    except BrokenPipeError:
        pass
    finally:
        ctl.kill()


# wayvrctl exits if WayVR's IPC isn't up yet or goes away; retry while a
# WayVR (incl. a replacement instance after a restart or crash) is running.
seen = None
while pid := wayvr_pid():
    if pid != seen:  # a new WayVR starts with the panel shown, even if the old one had it hidden
        seen = pid
        try:
            os.remove(HIDDEN)
        except FileNotFoundError:
            pass
    run(pid)
    if not os.path.exists(f"/proc/{pid}"):  # this WayVR is gone (closed or crashed)
        save_wayvr_log()
    time.sleep(2)
