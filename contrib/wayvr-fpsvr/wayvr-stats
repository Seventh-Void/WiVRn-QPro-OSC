#!/usr/bin/env python3
"""fpsVR-style stats panel on the WayVR watch.

Per-frame CPU/GPU times and the name of the focused VR app come from
/dev/shm/wivrn-frametime, written by wivrn-server from WiVRn-QPro-OSC
(v26.9-qpro.3 or later). Temps, load, VRAM and RAM come from sysfs/procfs
(AMD) or NVML (NVIDIA, untested). Everything goes to the watch through one
persistent `wayvrctl batch` pipe. Values that can't be read on this machine
stay "--"; nothing is estimated.

Settings (mode, which elements show, graphs) are read live from
~/.config/wayvr-stats/settings.json, written by the "FPS stats" tab of the
patched WayVR's Settings (or by hand). The master switch is "wayvr-stats" in
~/.config/wivrn/config.json (WiVRn dashboard or that tab).

Started by wayvr-stats.path whenever WayVR (re)writes its pid file; exits once
no WayVR is left.
"""
import collections
import contextlib
import ctypes
import datetime
import glob
import json
import mmap
import os
import re
import shlex
import sqlite3
import struct
import subprocess
import time
import zlib

SHM = "/dev/shm/wivrn-frametime"
# Per-user, mode 0700. No /tmp fallback: predictable names in a shared /tmp could be symlink-attacked.
RUNDIR = os.environ.get("XDG_RUNTIME_DIR") or exit("wayvr-stats: XDG_RUNTIME_DIR is not set (run it from a user session)")
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
GRAPH = os.path.join(RUNDIR, "wayvr-stats-{}-{}.png")  # alternates 0/1 so WayVR never reads a half-written file
PIDFILE = os.path.join(RUNDIR, "wayvr.pid")
HIDDEN = os.path.join(RUNDIR, "wayvr-stats.hidden")  # made/removed by the watch's Hide/Show stats button
SETTINGS = os.path.join(CONFIG_HOME, "wayvr-stats", "settings.json")
# WiVRn dashboard → Settings → "fpsVR-style stats on the WayVR watch" writes "wayvr-stats": false here
WIVRN_CONFIG = os.path.join(CONFIG_HOME, "wivrn", "config.json")
# WayVR truncates its log on every start, so save it as soon as WayVR exits
WAYVR_LOG = os.environ.get("WAYVR_LOGFILE", "/tmp/wayvr.log")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "wayvr-stats")
CRASH = re.compile(r"panicked|Atlas full")
KEEP_CRASHES = 10
VRCX_DB = os.path.join(CONFIG_HOME, "VRCX", "VRCX.sqlite3")  # optional: VRChat world time
W, H = 180, 32                      # must match the fv_*_graph images in watch.xml; 1 px per frame
GRAPH_HZ, LABEL_HZ = 15, 3
COLOR = os.environ.get("WAYVR_STATS_COLOR", "#FFFFFF")  # dashed budget line, #RRGGBB
TEXT = os.environ.get("WAYVR_STATS_TEXT", "#FFFFFF")  # labels that are fine; match the watch's text color
# Layout from app_pacer.cpp: u64 count, u32 period_us, u32 reserved, char app_name[64], frames
HDR, NAME, FRAME, RING = struct.Struct("=QII"), 64, struct.Struct("=II"), 256
FRAMES_AT = HDR.size + NAME
GIB = 1 << 30
ELEMENTS = ("title", "fps", "avg", "gpu_ms", "cpu_ms", "gpu", "vram", "cpu", "ram", "session", "world", "button")
MINIMAL_OFF = ("title", "gpu_ms", "cpu_ms", "gpu", "vram", "cpu", "ram")  # Minimal mode: FPS and Avg only

# fpsVR-style bar colors per frame: within budget, up to 25 % over, worse
GOOD, LATE, BAD = "#22C55E", "#F59E0B", "#EF4444"


def num(path, default=0):
    try:
        return int(open(path).read())
    except (OSError, ValueError, TypeError):
        return default


def hwmons(name):
    """hwmon dirs of a driver; their numbers change between boots, so look them up by name."""
    found = []
    for h in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        try:
            if open(f"{h}/name").read().strip() == name:
                found.append(h)
        except OSError:
            pass
    return found


def amd_gpu():
    """Reader for the amdgpu card with the most VRAM (so a Ryzen iGPU never hides the dGPU), or None."""
    cards = hwmons("amdgpu")
    if not cards:
        return None
    mon = max(cards, key=lambda h: num(f"{h}/device/mem_info_vram_total"))
    dev = f"{mon}/device"
    temp = f"{mon}/temp2_input" if os.path.exists(f"{mon}/temp2_input") else f"{mon}/temp1_input"  # temp2 = junction

    def read():
        t = num(temp, None)
        return (None if t is None else t // 1000, num(f"{dev}/gpu_busy_percent", None),
                num(f"{dev}/mem_info_vram_used", None), num(f"{dev}/mem_info_vram_total", None))
    return read


class _NvUtil(ctypes.Structure):
    _fields_ = [("gpu", ctypes.c_uint), ("memory", ctypes.c_uint)]


class _NvMem(ctypes.Structure):
    _fields_ = [("total", ctypes.c_ulonglong), ("free", ctypes.c_ulonglong), ("used", ctypes.c_ulonglong)]


def nvidia_gpu():
    """Reader for the first NVIDIA GPU through NVML (libnvidia-ml.so.1, part of the driver), or None.
    Untested: written without NVIDIA hardware. Any NVML error just leaves that value as "--"."""
    try:
        nvml = ctypes.CDLL("libnvidia-ml.so.1")
        if nvml.nvmlInit_v2() != 0:
            return None
        handle = ctypes.c_void_p()
        if nvml.nvmlDeviceGetHandleByIndex_v2(0, ctypes.byref(handle)) != 0:
            return None
    except (OSError, AttributeError):
        return None

    def read():
        temp, util, mem = ctypes.c_uint(), _NvUtil(), _NvMem()
        ok_temp = nvml.nvmlDeviceGetTemperature(handle, 0, ctypes.byref(temp)) == 0  # 0 = NVML_TEMPERATURE_GPU
        ok_util = nvml.nvmlDeviceGetUtilizationRates(handle, ctypes.byref(util)) == 0
        ok_mem = nvml.nvmlDeviceGetMemoryInfo(handle, ctypes.byref(mem)) == 0
        return (temp.value if ok_temp else None, util.gpu if ok_util else None,
                mem.used if ok_mem else None, mem.total if ok_mem else None)
    return read


# k10temp temp1 = Tctl (AMD); coretemp temp1 = package (Intel)
CPU_MON = next(iter(hwmons("k10temp") or hwmons("coretemp")), None)
GPU = amd_gpu() or nvidia_gpu()  # () -> (temp °C, load %, VRAM used, VRAM total), each None if unknown


def wayvr_pid():
    try:
        pid = open(PIDFILE).read().strip()
    except OSError:
        return None
    return pid if pid and os.path.exists(f"/proc/{pid}") else None


def cpu_times():
    v = list(map(int, open("/proc/stat").readline().split()[1:9]))
    return sum(v), v[3] + v[4]  # total, idle + iowait


def ram_gib():
    m = dict(line.split()[:2] for line in open("/proc/meminfo"))
    return (int(m["MemTotal:"]) - int(m["MemAvailable:"])) * 1024 / GIB, int(m["MemTotal:"]) * 1024 / GIB


# Label text comes from app names and VRChat world names (anyone can name a world). `wayvrctl batch` reads one
# command per line, so a newline in it could start another command (e.g. process-launch): drop control characters.
CONTROL = re.compile(r"[\x00-\x1f\x7f]")


def ms_color(us, period_us):
    return GOOD if us <= period_us else LATE if us <= period_us * 5 // 4 else BAD


def fps_color(fps, period_us):
    target = round(1e6 / period_us)  # 11111 us -> 90 fps
    return GOOD if fps >= target * 0.9 else LATE if fps >= target / 2 else BAD


def label_color(c):
    return TEXT if c == GOOD else c  # labels only stand out when orange or red


def png(values, period_us):
    """One bar per frame, colored by its frame time against the frame budget, as a 2x RGBA PNG.
    A PNG goes to the GPU as is; an SVG would be rasterized at the size of the whole watch panel."""
    top = 3 * period_us // 2  # dashed line = frame budget, at 2/3 height
    rows = [bytearray(W * 8) for _ in range(H * 2)]  # 2 px per unit, 4 bytes per px
    x0 = W - len(values)
    for i, v in enumerate(values):
        px = bytes.fromhex(ms_color(v, period_us)[1:]) + b"\xff"
        for y in range(2 * (H - min(v, top) * H // top), 2 * H):
            rows[y][8 * (x0 + i):8 * (x0 + i) + 8] = px * 2
    dash, a = bytes.fromhex(COLOR[1:7]), 0x88
    y = H - period_us * H // top
    for row in rows[2 * y - 1:2 * y + 1]:
        for x in range(2 * W):
            if x % 12 < 6:  # 3 units on, 3 off
                i = 4 * x
                if row[i + 3]:  # over a bar: blend into it
                    row[i:i + 3] = bytes((d * a + b * (255 - a)) // 255 for d, b in zip(dash, row[i:i + 3]))
                else:
                    row[i:i + 4] = dash + bytes((a,))
    chunk = lambda t, d: struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d))
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", 2 * W, 2 * H, 8, 6, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(b"".join(b"\0" + r for r in rows), 1)) + chunk(b"IEND", b""))


def read_json(path):
    try:
        data = json.load(open(path))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def turned_on():
    return read_json(WIVRN_CONFIG).get("wayvr-stats", True) is not False  # no or unreadable config: on


def load_settings():
    """settings.json -> {"show": {element: bool}, "graphs": bool, "minimal": bool}, with Minimal mode already applied."""
    data = read_json(SETTINGS)
    show = data.get("show") if isinstance(data.get("show"), dict) else {}
    show = {k: show.get(k, True) is not False for k in ELEMENTS}
    if data.get("mode") == "minimal":
        show.update({k: False for k in MINIMAL_OFF}, fps=True, avg=True)
    return {"show": show, "graphs": data.get("graphs") is not False, "minimal": data.get("mode") == "minimal"}


def visibility(on, hidden, show, minimal):
    """Watch element id -> visible, for the master switch, the Hide/Show button state and the settings."""
    gpu_col = show["gpu_ms"] or show["gpu"] or show["vram"]
    cpu_col = show["cpu_ms"] or show["cpu"] or show["ram"]
    fps_row = show["fps"] or show["avg"]
    hidden = hidden and show["button"]  # without the button the panel can't stay hidden
    return {
        "fv_panel": on and not hidden and (show["title"] or fps_row or gpu_col or cpu_col),
        "fv_header": (show["title"] or fps_row) and not minimal, "fv_minrow": minimal,
        "fv_title": show["title"], "fv_fpsrow": fps_row, "fv_fps": show["fps"], "fv_avg_fps": show["avg"],
        "fv_cols": gpu_col or cpu_col, "fv_gpu_col": gpu_col, "fv_cpu_col": cpu_col,
        "fv_gpu_ms": show["gpu_ms"], "fv_gpu_graphbox": show["gpu_ms"], "fv_gpu": show["gpu"], "fv_vram": show["vram"],
        "fv_cpu_ms": show["cpu_ms"], "fv_cpu_graphbox": show["cpu_ms"], "fv_cpu": show["cpu"], "fv_ram": show["ram"],
        "fv_session": on and show["session"], "fv_world": on and show["world"],
        "fv_hide_btn": on and show["button"] and not hidden, "fv_show_btn": on and show["button"] and hidden,
    }


def vrcx_running():
    for comm in glob.glob("/proc/[0-9]*/comm"):
        try:
            if open(comm).read().strip() == "VRCX":
                return True
        except OSError:  # process exited while scanning
            pass
    return False


def vrcx_world():
    """(world name, unix join time) of VRCX's newest location entry, or None without VRCX."""
    if not os.path.exists(VRCX_DB):  # no VRCX: world time stays off (turns on once VRCX is installed)
        return None
    if not vrcx_running():  # VRCX closed: it isn't logging world changes, so its newest world may be stale
        return None
    try:
        with contextlib.closing(sqlite3.connect(f"file:{VRCX_DB}?mode=ro", uri=True, timeout=0.2)) as db:
            row = db.execute("SELECT world_name, created_at FROM gamelog_location ORDER BY id DESC LIMIT 1").fetchone()
        return row[0], datetime.datetime.fromisoformat(row[1]).timestamp()
    except (sqlite3.Error, TypeError, ValueError):
        return None


def save_wayvr_log():
    """Copy the exited WayVR's log to STATE/last-wayvr.log, and to crash-<time>.log if it crashed."""
    try:
        text = open(WAYVR_LOG, errors="replace").read()[-4 << 20:]  # last 4 MB is plenty
    except OSError:
        return
    os.makedirs(STATE, exist_ok=True)
    open(os.path.join(STATE, "last-wayvr.log"), "w").write(text)
    if not CRASH.search(text):
        return

    def version(cmd):
        try:
            return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip().replace("\n", ", ") or "?"
        except (OSError, subprocess.SubprocessError):
            return "?"
    path = os.path.join(STATE, time.strftime("crash-%Y%m%d-%H%M%S.log"))
    header = (f"# WayVR crash log saved by wayvr-stats, {time.strftime('%Y-%m-%d %H:%M:%S %z')}\n"
              f"# {version(['wayvr', '--version'])}, {version(['wivrn-server', '--version'])}\n"
              f"# kernel {os.uname().release}\n\n")
    open(path, "w").write(header + text)
    for old in sorted(glob.glob(os.path.join(STATE, "crash-*.log")))[:-KEEP_CRASHES]:
        os.remove(old)
    print(f"WayVR crashed; its log is saved in {path}", flush=True)


def duration(s):
    m = int(s // 60)
    return f"{m} min" if m < 60 else f"{m // 60} h {m % 60} min"


def run(pid):
    ctl = subprocess.Popen(["wayvrctl", "batch", "--fail-fast"], stdin=subprocess.PIPE,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, text=True)
    shown, colors, visible = {}, {}, {}  # element id -> text / color / visibility currently on the watch

    def label(wid, text):
        if shown.get(wid) != text:
            shown[wid] = text
            ctl.stdin.write(f"panel-modify watch {wid} set-text -- {shlex.quote(CONTROL.sub(' ', text))}\n")

    def color(wid, hex_color):
        if colors.get(wid) != hex_color:
            colors[wid] = hex_color
            ctl.stdin.write(f"panel-modify watch {wid} set-color '{hex_color}'\n")

    shm, last, flip = None, 0, {"gpu": 0, "cpu": 0}  # per graph: next of its two files
    cpu_hist, gpu_hist = collections.deque(maxlen=W), collections.deque(maxlen=W)
    recent = collections.deque()  # (arrival time, cpu_us, gpu_us) over the last second
    app, app_start, app_frames = "", 0.0, 0
    on, settings, next_config = True, load_settings(), 0.0  # re-read every 2 s
    period_us, next_label, hidden, fps_from = 11111, 0.0, False, 0.0  # fps_from: start of a gap-free 1 s window
    seen, alive_at = -1, -1e9  # frame counter last seen, and when it last moved
    world, world_at = None, 0.0  # cached vrcx_world() and when it was read
    pt, pi = cpu_times()

    def header(now):
        """Read the shm header only: focused app and frame counter. Returns the counter."""
        nonlocal app, app_start, app_frames, fps_from, last, period_us, seen, alive_at
        count, period_us, _ = HDR.unpack_from(shm)
        period_us = period_us or 11111
        name = shm[HDR.size:FRAMES_AT].split(b"\0", 1)[0].decode(errors="replace")
        name = name if len(name) <= 30 else name[:29] + "…"  # fit the watch width
        if name != app:  # new focused app: restart session stats
            app, app_start, app_frames, fps_from = name, now, 0, now
            cpu_hist.clear(), gpu_hist.clear()
        if count < last:  # wivrn-server restarted
            last = count
        if count != seen:
            seen, alive_at = count, now
        return count

    def session(now):
        nonlocal world, world_at
        # under the clock, so it stays visible (and counting) while the stats panel is hidden
        in_game = app and now - alive_at < 5
        name = app if len(app) <= 16 else app[:15] + "…"  # the clock face is narrower than the panel
        label("fv_session", f"{name} - {duration(now - app_start)}" if in_game else "No VR game")
        if in_game and "VRChat" in app and settings["show"]["world"]:
            if now - world_at >= 5:
                world, world_at = vrcx_world(), now
        else:
            world = None
        if world:
            wname = world[0] if len(world[0]) <= 16 else world[0][:15] + "…"
            label("fv_world", f"{wname} - {duration(time.time() - world[1])}")
        else:
            label("fv_world", "")

    try:
        while os.path.exists(f"/proc/{pid}") and ctl.poll() is None:
            now = time.monotonic()

            if shm is None and os.path.exists(SHM) and os.path.getsize(SHM) >= FRAMES_AT + RING * FRAME.size:
                with open(SHM, "rb") as f:
                    shm = mmap.mmap(f.fileno(), 0, prot=mmap.PROT_READ)
                last = HDR.unpack_from(shm)[0]  # start from now, skip old frames

            if now >= next_config:
                next_config = now + 2
                on, settings = turned_on(), load_settings()
                if not settings["show"]["button"] and os.path.exists(HIDDEN):
                    os.remove(HIDDEN)  # no button left to show the stats again
                for wid, vis in visibility(on, os.path.exists(HIDDEN), settings["show"], settings["minimal"]).items():
                    if visible.get(wid) != vis:  # everything on the first pass, then only changes
                        visible[wid] = vis
                        ctl.stdin.write(f"panel-modify watch {wid} set-visible {1 if vis else 0}\n")
                ctl.stdin.flush()
            show = settings["show"]
            if not on:  # turned off: nothing on the watch, no reads
                hidden = True  # resume like "Show stats" when turned back on
                time.sleep(0.5)
                continue

            if os.path.exists(HIDDEN):  # panel hidden: only the game time under the clock keeps going
                hidden = True
                if shm is not None:
                    prev = app
                    count = header(now)
                    if app != prev:  # don't count the old app's frames in the new one's Avg
                        last = count
                session(now)
                ctl.stdin.flush()
                time.sleep(0.5)
                continue
            if hidden:  # shown again: drop the stale graphs, but keep the missed frames in Avg
                hidden = False
                if shm is not None:
                    count = header(now)
                    app_frames += max(count - last, 0)
                    last = count
                cpu_hist.clear(), gpu_hist.clear(), recent.clear()
                pt, pi, fps_from = *cpu_times(), now

            new = 0
            if shm is not None:
                count = header(now)
                for n in range(max(last, count - RING), count):
                    c, g = FRAME.unpack_from(shm, FRAMES_AT + (n % RING) * FRAME.size)
                    cpu_hist.append(c), gpu_hist.append(g), recent.append((now, c, g))
                    new += 1
                app_frames += new
                last = count
            while recent and recent[0][0] < now - 1:
                recent.popleft()

            # Graphs only for columns that show
            if new and settings["graphs"]:
                for key, hist in (("gpu", gpu_hist), ("cpu", cpu_hist)):
                    if show[f"{key}_ms"]:
                        path = GRAPH.format(key, flip[key])
                        with open(path, "wb") as f:
                            f.write(png(hist, period_us))
                        ctl.stdin.write(f"panel-modify watch fv_{key}_graph set-image {path}\n")
                        flip[key] ^= 1

            if now >= next_label:
                next_label = now + 1 / LABEL_HZ
                session(now)
                if app and recent:
                    n = len(recent)
                    avg = app_frames / max(now - app_start, 1e-3)
                    gpu_us, cpu_us = sum(r[2] for r in recent) / n, sum(r[1] for r in recent) / n
                    label("fv_title", app)
                    if now - fps_from >= 1:  # needs a full 1 s window
                        label("fv_fps", f"FPS {n}"), color("fv_fps", label_color(fps_color(n, period_us)))
                    else:
                        label("fv_fps", "FPS --"), color("fv_fps", TEXT)
                    label("fv_avg_fps", f"Avg {avg:.1f}"), color("fv_avg_fps", label_color(fps_color(avg, period_us)))
                    label("fv_gpu_ms", f"{gpu_us / 1000:.1f} ms"), color("fv_gpu_ms", label_color(ms_color(gpu_us, period_us)))
                    label("fv_cpu_ms", f"{cpu_us / 1000:.1f} ms"), color("fv_cpu_ms", label_color(ms_color(cpu_us, period_us)))
                else:
                    label("fv_title", app or "No VR app")
                    label("fv_fps", "FPS --")
                    label("fv_gpu_ms", "-- ms")
                    label("fv_cpu_ms", "-- ms")
                    for wid in ("fv_fps", "fv_avg_fps", "fv_gpu_ms", "fv_cpu_ms"):
                        color(wid, TEXT)
                # Minimal mode's big numbers: FPS and Avg without their prefix, same colors
                for big, wid in (("fv_min_fps", "fv_fps"), ("fv_min_avg", "fv_avg_fps")):
                    label(big, shown.get(wid, "--").split()[-1]), color(big, colors.get(wid, TEXT))

                # hardware lines: only read what shows
                if show["cpu"]:
                    t, i = cpu_times()
                    cpu_load, pt, pi = 100 * ((t - pt) - (i - pi)) // max(t - pt, 1), t, i
                    temp = f"{num(f'{CPU_MON}/temp1_input') // 1000}°C  " if CPU_MON else ""
                    label("fv_cpu", f"{temp}{cpu_load}%")
                if show["gpu"] or show["vram"]:
                    temp, load, used, total = GPU() if GPU else (None, None, None, None)
                    label("fv_gpu", f"{'--' if temp is None else temp}°C  {'--' if load is None else load}%")
                    label("fv_vram", f"{used / GIB:.1f}/{total / GIB:.1f} GB" if used is not None and total else "--")
                if show["ram"]:
                    used, total = ram_gib()
                    label("fv_ram", f"{used:.1f}/{total:.1f} GB")

            ctl.stdin.flush()
            time.sleep(1 / GRAPH_HZ)
    except BrokenPipeError:
        pass
    finally:
        ctl.kill()
        try:
            ctl.stdin.close()  # else the unflushed buffer raises again when Python frees it
        except BrokenPipeError:
            pass


# wayvrctl exits if WayVR's IPC isn't up yet or goes away; retry while a
# WayVR (incl. a replacement instance after a restart or crash) is running.
seen = None
while pid := wayvr_pid():
    if pid != seen:  # a new WayVR starts with the panel shown, even if the old one had it hidden
        seen = pid
        try:
            os.remove(HIDDEN)
        except FileNotFoundError:
            pass
    run(pid)
    if not os.path.exists(f"/proc/{pid}"):  # this WayVR is gone (closed or crashed)
        save_wayvr_log()
    time.sleep(2)
